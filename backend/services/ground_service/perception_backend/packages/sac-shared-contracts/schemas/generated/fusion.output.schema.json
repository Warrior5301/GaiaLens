{
  "$defs": {
    "AlignmentReport": {
      "additionalProperties": false,
      "description": "Diagnostic report documenting spatial coregistration accuracy.",
      "properties": {
        "registered": {
          "description": "Whether coregistration succeeded within tolerance",
          "title": "Registered",
          "type": "boolean"
        },
        "residual_rmse_px": {
          "description": "Root Mean Square Error of alignment residuals in pixels",
          "minimum": 0.0,
          "title": "Residual Rmse Px",
          "type": "number"
        },
        "target_crs": {
          "description": "Common output coordinate reference system (e.g. EPSG:3857)",
          "title": "Target Crs",
          "type": "string"
        },
        "target_resolution_m": {
          "description": "Common output ground sample distance in meters",
          "exclusiveMinimum": 0.0,
          "title": "Target Resolution M",
          "type": "number"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Alignment diagnostic observations or caveats",
          "title": "Notes"
        }
      },
      "required": [
        "registered",
        "residual_rmse_px",
        "target_crs",
        "target_resolution_m"
      ],
      "title": "AlignmentReport",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Reference to derived data artifacts stored externally to keep agent state lightweight.",
      "properties": {
        "artifact_id": {
          "description": "Unique derived artifact identifier",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "description": "Class of artifact stored",
          "enum": [
            "image",
            "crop",
            "roi",
            "detection_set",
            "obb_set",
            "segmentation_mask",
            "polygon",
            "measurement",
            "spatial_relation",
            "ocr_result",
            "aligned_asset",
            "fusion_feature",
            "change_map"
          ],
          "title": "Artifact Type",
          "type": "string"
        },
        "uri": {
          "description": "Storage URI or relative artifact path",
          "title": "Uri",
          "type": "string"
        },
        "source_asset_ids": {
          "description": "IDs of source assets that contributed to this artifact",
          "items": {
            "type": "string"
          },
          "title": "Source Asset Ids",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "description": "Arbitrary artifact metadata properties",
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "artifact_id",
        "artifact_type",
        "uri"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Output contract from multimodal fusion operations.",
  "properties": {
    "fused_artifact": {
      "$ref": "#/$defs/ArtifactRef",
      "description": "Artifact reference to derived fused composite or aligned multi-band tensor"
    },
    "alignment_report": {
      "$ref": "#/$defs/AlignmentReport",
      "description": "Formal coregistration and alignment quality metrics"
    },
    "metadata": {
      "additionalProperties": true,
      "description": "Fusion algorithm metadata",
      "title": "Metadata",
      "type": "object"
    }
  },
  "required": [
    "fused_artifact",
    "alignment_report"
  ],
  "title": "FusionOutput",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sac.geoai.org/schemas/v0.1.1/fusion.output.schema.json",
  "x-schema-version": "0.1.1"
}