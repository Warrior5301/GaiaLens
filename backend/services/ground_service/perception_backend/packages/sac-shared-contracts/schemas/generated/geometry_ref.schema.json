{
  "$defs": {
    "BBoxPx": {
      "additionalProperties": false,
      "description": "Canonical 2D Axis-Aligned Bounding Box in image pixel coordinates.",
      "properties": {
        "x_min": {
          "description": "Left pixel coordinate",
          "title": "X Min",
          "type": "number"
        },
        "y_min": {
          "description": "Top pixel coordinate",
          "title": "Y Min",
          "type": "number"
        },
        "x_max": {
          "description": "Right pixel coordinate",
          "title": "X Max",
          "type": "number"
        },
        "y_max": {
          "description": "Bottom pixel coordinate",
          "title": "Y Max",
          "type": "number"
        }
      },
      "required": [
        "x_min",
        "y_min",
        "x_max",
        "y_max"
      ],
      "title": "BBoxPx",
      "type": "object"
    },
    "GeoPoint": {
      "additionalProperties": false,
      "description": "Geographic coordinate representation.",
      "properties": {
        "latitude": {
          "description": "Latitude in decimal degrees",
          "maximum": 90.0,
          "minimum": -90.0,
          "title": "Latitude",
          "type": "number"
        },
        "longitude": {
          "description": "Longitude in decimal degrees",
          "maximum": 180.0,
          "minimum": -180.0,
          "title": "Longitude",
          "type": "number"
        },
        "altitude_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional altitude above sea level in meters",
          "title": "Altitude M"
        },
        "crs": {
          "default": "EPSG:4326",
          "description": "Coordinate Reference System identifier",
          "title": "Crs",
          "type": "string"
        }
      },
      "required": [
        "latitude",
        "longitude"
      ],
      "title": "GeoPoint",
      "type": "object"
    },
    "PointPx": {
      "additionalProperties": false,
      "description": "2D point in canonical image pixel coordinates (origin: top-left, x: right, y: down).",
      "properties": {
        "x": {
          "description": "Horizontal pixel coordinate (columns from left edge)",
          "title": "X",
          "type": "number"
        },
        "y": {
          "description": "Vertical pixel coordinate (rows from top edge)",
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "PointPx",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Discriminated spatial geometry reference with semantic validation.",
  "properties": {
    "geometry_type": {
      "description": "Active discriminator type for geometry representation",
      "enum": [
        "bbox_px",
        "polygon",
        "point",
        "artifact"
      ],
      "title": "Geometry Type",
      "type": "string"
    },
    "bbox_px": {
      "anyOf": [
        {
          "$ref": "#/$defs/BBoxPx"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Axis-aligned bounding box"
    },
    "polygon": {
      "anyOf": [
        {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Contour polygon coordinates [[x1, y1], [x2, y2], ...]",
      "title": "Polygon"
    },
    "point": {
      "anyOf": [
        {
          "$ref": "#/$defs/PointPx"
        },
        {
          "$ref": "#/$defs/GeoPoint"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "2D pixel point or geographic point",
      "title": "Point"
    },
    "artifact_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Derived artifact identifier (e.g. mask or shapefile)",
      "title": "Artifact Id"
    }
  },
  "required": [
    "geometry_type"
  ],
  "title": "GeometryRef",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sac.geoai.org/schemas/v0.1.1/geometry_ref.schema.json",
  "x-schema-version": "0.1.1"
}