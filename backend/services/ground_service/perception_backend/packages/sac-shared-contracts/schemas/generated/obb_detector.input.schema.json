{
  "$defs": {
    "AssetRef": {
      "additionalProperties": false,
      "description": "Reference to an input satellite/aerial imagery asset (does NOT store image tensors).",
      "properties": {
        "asset_id": {
          "description": "Unique asset identifier",
          "title": "Asset Id",
          "type": "string"
        },
        "uri": {
          "description": "Storage URI or filesystem path to image asset",
          "title": "Uri",
          "type": "string"
        },
        "modality": {
          "$ref": "#/$defs/Modality",
          "default": "optical",
          "description": "Sensor modality classification"
        },
        "width_px": {
          "description": "Image width in pixels",
          "exclusiveMinimum": 0,
          "title": "Width Px",
          "type": "integer"
        },
        "height_px": {
          "description": "Image height in pixels",
          "exclusiveMinimum": 0,
          "title": "Height Px",
          "type": "integer"
        },
        "gsd_m": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ground Sample Distance in meters per pixel",
          "title": "Gsd M"
        },
        "crs": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Coordinate Reference System (e.g. EPSG:4326, EPSG:3857)",
          "title": "Crs"
        },
        "acquisition_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO-8601 acquisition timestamp",
          "title": "Acquisition Time"
        },
        "bands": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "List of spectral band identifiers (e.g. ['R', 'G', 'B', 'NIR'])",
          "title": "Bands"
        }
      },
      "required": [
        "asset_id",
        "uri",
        "width_px",
        "height_px"
      ],
      "title": "AssetRef",
      "type": "object"
    },
    "BBoxPx": {
      "additionalProperties": false,
      "description": "Canonical 2D Axis-Aligned Bounding Box in image pixel coordinates.",
      "properties": {
        "x_min": {
          "description": "Left pixel coordinate",
          "title": "X Min",
          "type": "number"
        },
        "y_min": {
          "description": "Top pixel coordinate",
          "title": "Y Min",
          "type": "number"
        },
        "x_max": {
          "description": "Right pixel coordinate",
          "title": "X Max",
          "type": "number"
        },
        "y_max": {
          "description": "Bottom pixel coordinate",
          "title": "Y Max",
          "type": "number"
        }
      },
      "required": [
        "x_min",
        "y_min",
        "x_max",
        "y_max"
      ],
      "title": "BBoxPx",
      "type": "object"
    },
    "Modality": {
      "description": "Supported sensor modalities for input imagery.",
      "enum": [
        "optical",
        "sar",
        "infrared",
        "thermal",
        "multispectral",
        "hyperspectral",
        "panchromatic"
      ],
      "title": "Modality",
      "type": "string"
    },
    "RotatedNMSConfig": {
      "additionalProperties": false,
      "description": "Non-Maximum Suppression configuration for oriented bounding boxes.",
      "properties": {
        "iou_threshold": {
          "default": 0.4,
          "description": "Rotated IoU cutoff",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Iou Threshold",
          "type": "number"
        },
        "score_threshold": {
          "default": 0.25,
          "description": "Confidence cutoff",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score Threshold",
          "type": "number"
        },
        "max_detections": {
          "default": 300,
          "description": "Maximum detections to retain",
          "exclusiveMinimum": 0,
          "title": "Max Detections",
          "type": "integer"
        }
      },
      "title": "RotatedNMSConfig",
      "type": "object"
    },
    "TilingConfig": {
      "additionalProperties": false,
      "description": "Configuration for sliding-window patch tiling over large satellite imagery.",
      "properties": {
        "enabled": {
          "default": false,
          "description": "Whether to enable sliding window tiling",
          "title": "Enabled",
          "type": "boolean"
        },
        "tile_size_px": {
          "default": 512,
          "description": "Square tile dimension in pixels",
          "exclusiveMinimum": 0,
          "title": "Tile Size Px",
          "type": "integer"
        },
        "overlap_px": {
          "default": 64,
          "description": "Pixel overlap between adjacent tiles",
          "minimum": 0,
          "title": "Overlap Px",
          "type": "integer"
        }
      },
      "title": "TilingConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Input contract for Oriented Bounding Box detector.",
  "properties": {
    "asset": {
      "$ref": "#/$defs/AssetRef",
      "description": "Target image asset reference"
    },
    "target_classes": {
      "description": "Target object classes to detect",
      "items": {
        "type": "string"
      },
      "title": "Target Classes",
      "type": "array"
    },
    "roi": {
      "anyOf": [
        {
          "$ref": "#/$defs/BBoxPx"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional spatial ROI sub-window"
    },
    "confidence_threshold": {
      "default": 0.35,
      "description": "Minimum detection confidence cutoff",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence Threshold",
      "type": "number"
    },
    "rotated_nms_config": {
      "$ref": "#/$defs/RotatedNMSConfig",
      "description": "Rotated NMS parameters"
    },
    "tiling_config": {
      "$ref": "#/$defs/TilingConfig",
      "description": "Tiling configuration"
    }
  },
  "required": [
    "asset"
  ],
  "title": "OBBDetectorInput",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sac.geoai.org/schemas/v0.1.1/obb_detector.input.schema.json",
  "x-schema-version": "0.1.1"
}