{
  "$defs": {
    "AssetRef": {
      "additionalProperties": false,
      "description": "Reference to an input satellite/aerial imagery asset (does NOT store image tensors).",
      "properties": {
        "asset_id": {
          "description": "Unique asset identifier",
          "title": "Asset Id",
          "type": "string"
        },
        "uri": {
          "description": "Storage URI or filesystem path to image asset",
          "title": "Uri",
          "type": "string"
        },
        "modality": {
          "$ref": "#/$defs/Modality",
          "default": "optical",
          "description": "Sensor modality classification"
        },
        "width_px": {
          "description": "Image width in pixels",
          "exclusiveMinimum": 0,
          "title": "Width Px",
          "type": "integer"
        },
        "height_px": {
          "description": "Image height in pixels",
          "exclusiveMinimum": 0,
          "title": "Height Px",
          "type": "integer"
        },
        "gsd_m": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ground Sample Distance in meters per pixel",
          "title": "Gsd M"
        },
        "crs": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Coordinate Reference System (e.g. EPSG:4326, EPSG:3857)",
          "title": "Crs"
        },
        "acquisition_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO-8601 acquisition timestamp",
          "title": "Acquisition Time"
        },
        "bands": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "List of spectral band identifiers (e.g. ['R', 'G', 'B', 'NIR'])",
          "title": "Bands"
        }
      },
      "required": [
        "asset_id",
        "uri",
        "width_px",
        "height_px"
      ],
      "title": "AssetRef",
      "type": "object"
    },
    "BBoxPx": {
      "additionalProperties": false,
      "description": "Canonical 2D Axis-Aligned Bounding Box in image pixel coordinates.",
      "properties": {
        "x_min": {
          "description": "Left pixel coordinate",
          "title": "X Min",
          "type": "number"
        },
        "y_min": {
          "description": "Top pixel coordinate",
          "title": "Y Min",
          "type": "number"
        },
        "x_max": {
          "description": "Right pixel coordinate",
          "title": "X Max",
          "type": "number"
        },
        "y_max": {
          "description": "Bottom pixel coordinate",
          "title": "Y Max",
          "type": "number"
        }
      },
      "required": [
        "x_min",
        "y_min",
        "x_max",
        "y_max"
      ],
      "title": "BBoxPx",
      "type": "object"
    },
    "Modality": {
      "description": "Supported sensor modalities for input imagery.",
      "enum": [
        "optical",
        "sar",
        "infrared",
        "thermal",
        "multispectral",
        "hyperspectral",
        "panchromatic"
      ],
      "title": "Modality",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Input contract for Segmentation_Grounding tool.",
  "properties": {
    "asset": {
      "$ref": "#/$defs/AssetRef",
      "description": "Target image asset reference"
    },
    "text_prompt": {
      "description": "Referring expression or target object description",
      "title": "Text Prompt",
      "type": "string"
    },
    "roi": {
      "anyOf": [
        {
          "$ref": "#/$defs/BBoxPx"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional spatial constraint"
    },
    "pipeline": {
      "default": "remote_sam_sam3_v2",
      "description": "Segmentation grounding pipeline variant",
      "enum": [
        "remote_sam",
        "remote_sam_only",
        "remote_sam_sam3_v1",
        "remote_sam_sam3_v2"
      ],
      "title": "Pipeline",
      "type": "string"
    },
    "return_polygon": {
      "default": true,
      "description": "Whether to extract contour polygons",
      "title": "Return Polygon",
      "type": "boolean"
    },
    "return_obb": {
      "default": true,
      "description": "Whether to compute minimum area oriented box",
      "title": "Return Obb",
      "type": "boolean"
    },
    "confidence_threshold": {
      "default": 0.35,
      "description": "Minimum mask confidence cutoff",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence Threshold",
      "type": "number"
    }
  },
  "required": [
    "asset",
    "text_prompt"
  ],
  "title": "SegmentationGroundingInput",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sac.geoai.org/schemas/v0.1.1/segmentation_grounding.input.schema.json",
  "x-schema-version": "0.1.1"
}