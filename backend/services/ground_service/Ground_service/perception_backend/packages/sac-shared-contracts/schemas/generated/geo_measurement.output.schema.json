{
  "$defs": {
    "Confidence": {
      "additionalProperties": false,
      "description": "Quantitative confidence score and calibration details.",
      "properties": {
        "score": {
          "description": "Confidence score between 0.0 and 1.0",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        },
        "calibrated": {
          "default": false,
          "description": "Whether the score represents a calibrated probability",
          "title": "Calibrated",
          "type": "boolean"
        },
        "source": {
          "description": "Origin of confidence estimate: e.g. model_logits, ensemble_vote, rule_heuristic",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "score",
        "source"
      ],
      "title": "Confidence",
      "type": "object"
    },
    "MeasurementValue": {
      "additionalProperties": false,
      "description": "Quantitative measurement with unit and confidence.",
      "properties": {
        "value": {
          "description": "Numerical scalar value",
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "description": "Unit of measurement: e.g. 'm', 'm2', 'km', 'km2', 'hectares', 'degrees'",
          "title": "Unit",
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence",
          "description": "Measurement confidence and method"
        },
        "method": {
          "default": "pixel_gsd",
          "description": "Computation method: e.g. geodesic, projected, gsd",
          "title": "Method",
          "type": "string"
        }
      },
      "required": [
        "value",
        "unit",
        "confidence"
      ],
      "title": "MeasurementValue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Output contract from Geo_Measurement tool.",
  "properties": {
    "measurements": {
      "additionalProperties": {
        "$ref": "#/$defs/MeasurementValue"
      },
      "description": "Map of measurement_type to quantitative MeasurementValue",
      "title": "Measurements",
      "type": "object"
    },
    "metadata": {
      "additionalProperties": true,
      "description": "Execution metadata",
      "title": "Metadata",
      "type": "object"
    }
  },
  "required": [
    "measurements"
  ],
  "title": "GeoMeasurementOutput",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sac.geoai.org/schemas/v0.1.1/geo_measurement.output.schema.json",
  "x-schema-version": "0.1.1"
}